{
  "manifest_version": 3,
  "name": "PromptForge — Capture Prompts",
  "description": "Save prompts from any AI chat into your PromptForge library, and find your saved prompts without leaving the page.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "PromptForge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "contextMenus", "scripting", "activeTab", "notifications"],
  "host_permissions": ["https://promptforge.fastapicloud.dev/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
